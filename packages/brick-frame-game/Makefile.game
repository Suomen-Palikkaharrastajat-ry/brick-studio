# Shared make targets of the Brick Frame games (brick-racer, brick-sails).
#
# A game's own Makefile sets its name and ports, defines `help` and the
# bootstrap `vendor` target (which must work before this file exists), and
# then includes this file from the brick-studio submodule:
#
#   GAME_NAME := racer
#   WATCH_PORT ?= 5176
#   PREVIEW_PORT ?= 4176
#   ...
#   -include vendor/brick-studio/packages/brick-frame-game/Makefile.game

VITE ?= vite --configLoader native
GAME_NAME ?= game
WATCH_PORT ?= 5176
PREVIEW_PORT ?= 4176

# ── Development environment ──────────────────────────────────────────────────

.PHONY: shell
shell: ## Enter devenv shell
	devenv shell

.PHONY: develop
develop: devenv.local.nix devenv.local.yaml ## Bootstrap devenv shell + VS Code
	devenv shell --profile=devcontainer -- code .

# ── Sources ──────────────────────────────────────────────────────────────────

SHARED_ELM_SOURCES := $(shell find vendor/packages/ -name '*.elm' 2>/dev/null)
SHARED_JS_SOURCES := $(shell find vendor/packages/brick-frame-game/runtime vendor/packages/brick-frame-viewport/runtime -name '*.js' 2>/dev/null)
GAME_SOURCES := $(shell find src -name '*.elm') $(SHARED_ELM_SOURCES)
GAME_JS_SOURCES := $(filter-out %.test.mjs,$(wildcard *.js)) $(SHARED_JS_SOURCES)
ELM_PACKAGE_SOURCES := $(shell find packages/ -name '*.elm' -o -name '*.css' 2>/dev/null)
SHARED_CSS_SOURCES := $(wildcard vendor/packages/brick-frame-ui/*.css)
JS_TESTS := $(wildcard *.test.mjs)

# ── Development & Build ──────────────────────────────────────────────────────

.PHONY: elm-tailwind-gen
elm-tailwind-gen: .elm-tailwind/.stamp ## Generate typed Tailwind Elm modules

.elm-tailwind/.stamp: elm.json vite.config.mjs main.css $(SHARED_CSS_SOURCES) $(GAME_SOURCES) $(ELM_PACKAGE_SOURCES)
	elm-tailwind-classes gen
	mkdir -p .elm-tailwind
	touch $@

.PHONY: $(GAME_NAME)-dev
$(GAME_NAME)-dev: elm-tailwind-gen
	$(VITE) --host 0.0.0.0 --port $(WATCH_PORT)

.PHONY: dev
dev: $(GAME_NAME)-dev ## Start Vite dev server (WATCH_PORT)

build/.stamp: elm-tailwind-gen index.html main.css vite.config.mjs $(GAME_JS_SOURCES) $(SHARED_CSS_SOURCES) $(GAME_SOURCES) $(ELM_PACKAGE_SOURCES)
	mkdir -p build
	$(VITE) build --outDir build
	touch $@

.PHONY: $(GAME_NAME)-build
$(GAME_NAME)-build: build/.stamp

.PHONY: build
build: $(GAME_NAME)-build ## Production build → build/

.PHONY: preview
preview: build ## Preview production build locally (PREVIEW_PORT)
	$(VITE) preview --outDir build --host 0.0.0.0 --port $(PREVIEW_PORT)

.PHONY: serve
serve: preview ## Alias for preview

# ── Test & Quality ───────────────────────────────────────────────────────────

.PHONY: elm-test
elm-test: elm-tailwind-gen ## Run all unit tests
	elm-test

.PHONY: js-test
js-test: ## Run the game's own JS unit tests (*.test.mjs), if it has any
	$(if $(JS_TESTS),node --test $(JS_TESTS),@echo "No JS unit tests in this game")

.PHONY: test
test: check elm-test js-test ## Run check, Elm tests and JS tests

.PHONY: elm-check
elm-check: ## Check Elm formatting (no changes)
	elm-format --validate src/ tests/

.PHONY: elm-format
elm-format: ## Auto-format Elm source files
	elm-format --yes src/ tests/

.PHONY: elm-review
elm-review: ## Run elm-review rules
	elm-review

.PHONY: elm-review-fix
elm-review-fix: ## Run elm-review with auto-fix
	elm-review --fix

.PHONY: check
check: elm-check elm-review ## Validate Elm formatting and review rules

.PHONY: format
format: elm-format ## Auto-format source files
	treefmt

# ── Cleanup ───────────────────────────────────────────────────────────────────

.PHONY: clean
clean: ## Remove build artifacts
	rm -rf build .elm-tailwind elm-stuff .vite
